{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/schemas/interchange-config.schema.json",
  "title": "Interchange Configuration Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "programs",
    "rules"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "version",
        "network",
        "region",
        "effective_from",
        "source_references"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "network": {
          "enum": [
            "VISA",
            "MASTERCARD"
          ]
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "effective_from": {
          "type": "string",
          "format": "date-time"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "environment": {
          "enum": [
            "DEV",
            "TEST",
            "UAT",
            "SHADOW",
            "PROD"
          ]
        },
        "source_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "checksum": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "network",
          "region",
          "effective_from"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "network_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "network": {
            "enum": [
              "VISA",
              "MASTERCARD"
            ]
          },
          "region": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "effective_from": {
            "type": "string",
            "format": "date-time"
          },
          "effective_to": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "fallback": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "program_id",
          "priority",
          "conditions",
          "rate",
          "effective_from",
          "source_reference"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "program_id": {
            "type": "string"
          },
          "priority": {
            "type": "integer"
          },
          "conditions": {
            "$ref": "#/$defs/conditionGroup"
          },
          "rate": {
            "$ref": "#/$defs/rate"
          },
          "effective_from": {
            "type": "string",
            "format": "date-time"
          },
          "effective_to": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "source_reference": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "operator"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "operator": {
          "enum": [
            "equals",
            "not_equals",
            "in",
            "not_in",
            "range",
            "exists",
            "missing",
            "gt",
            "gte",
            "lt",
            "lte"
          ]
        },
        "value": {},
        "values": {
          "type": "array"
        },
        "min": {},
        "max": {}
      }
    },
    "conditionGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/condition"
              },
              {
                "$ref": "#/$defs/conditionGroup"
              }
            ]
          }
        },
        "any": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/condition"
              },
              {
                "$ref": "#/$defs/conditionGroup"
              }
            ]
          }
        },
        "none": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/condition"
              },
              {
                "$ref": "#/$defs/conditionGroup"
              }
            ]
          }
        }
      },
      "minProperties": 1
    },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "percentage_bps",
        "fixed_minor_units",
        "rounding_policy"
      ],
      "properties": {
        "percentage_bps": {
          "type": "integer",
          "minimum": 0
        },
        "fixed_minor_units": {
          "type": "integer"
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "minimum_minor_units": {
          "type": [
            "integer",
            "null"
          ]
        },
        "maximum_minor_units": {
          "type": [
            "integer",
            "null"
          ]
        },
        "rounding_policy": {
          "enum": [
            "HALF_UP_MINOR_UNIT",
            "HALF_EVEN_MINOR_UNIT",
            "DOWN_MINOR_UNIT",
            "UP_MINOR_UNIT"
          ]
        }
      }
    }
  }
}