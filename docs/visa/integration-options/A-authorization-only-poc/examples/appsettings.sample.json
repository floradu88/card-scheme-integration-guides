{
  "visa": {
    "environment": "Sandbox",
    "base_url": "SET_FROM_VISA_PROJECT",
    "certificate_secret_name": "visa-sandbox-client-cert",
    "timeout_seconds": 15,
    "retry_policy": "OPERATION_SPECIFIC",
    "api_version": "PIN_TO_APPROVED_VERSION"
  },
  "observability": {
    "log_payloads": false,
    "log_sensitive_data": false,
    "certificate_expiry_alert_days": [
      90,
      60,
      30,
      14,
      7
    ]
  },
  "interchange": {
    "mode": "SHADOW",
    "configuration_version": "SET_EXPLICITLY",
    "persist_estimate_and_actual_separately": true
  }
}