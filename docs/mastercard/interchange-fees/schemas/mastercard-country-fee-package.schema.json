{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/schemas/mastercard-country-fee-package.schema.json",
  "title": "Mastercard Country Fee Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "programs", "rules"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "version",
        "network",
        "country_code",
        "region",
        "effective_from",
        "source_references"
      ],
      "properties": {
        "package_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "network": { "const": "MASTERCARD" },
        "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "region": { "type": "string", "minLength": 1 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "effective_from": { "type": "string", "format": "date-time" },
        "effective_to": { "type": ["string", "null"], "format": "date-time" },
        "environment": {
          "enum": ["DEV", "TEST", "UAT", "SHADOW", "PROD"]
        },
        "update_type": {
          "enum": ["CYCLE", "HOTFIX", "INITIAL", "OVERLAY"]
        },
        "source_references": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "checksum": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "programs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "network", "effective_from"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "network": { "const": "MASTERCARD" },
          "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "region": { "type": "string" },
          "effective_from": { "type": "string", "format": "date-time" },
          "fallback": { "type": "boolean" }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "program_id", "priority", "effective_from", "conditions", "rate"],
        "properties": {
          "id": { "type": "string" },
          "program_id": { "type": "string" },
          "priority": { "type": "integer" },
          "effective_from": { "type": "string", "format": "date-time" },
          "source_reference": { "type": "string" },
          "conditions": { "type": "object" },
          "rate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["percentage_bps", "fixed_minor_units", "rounding_policy"],
            "properties": {
              "percentage_bps": { "type": "integer", "minimum": 0 },
              "fixed_minor_units": { "type": "integer", "minimum": 0 },
              "min_minor_units": { "type": ["integer", "null"], "minimum": 0 },
              "max_minor_units": { "type": ["integer", "null"], "minimum": 0 },
              "rounding_policy": {
                "enum": ["HALF_UP_MINOR_UNIT", "HALF_EVEN_MINOR_UNIT", "FLOOR_MINOR_UNIT"]
              }
            }
          }
        }
      }
    }
  }
}
